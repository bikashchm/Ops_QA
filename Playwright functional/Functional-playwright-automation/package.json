{
  "name": "linqx_playwright_liveplus_automation",
  "version": "1.0.0",
  "description": "LivePlus Playwright + TypeScript enterprise automation framework",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --headed --project=chromium",
    "test:all": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui",
    "test:sample": "playwright test --grep \"@sample\" --project=chromium",
    "report": "playwright show-report",
    "report:html": "playwright show-report playwright-report",
    "report:allure": "node scripts/generate-allure-report.js",
    "report:allure:open": "node scripts/generate-allure-report.js && npx allure open reports/allure-report",
    "report:open": "node scripts/open-reports.js",
    "report:ci": "node scripts/generate-allure-report.js",
    "smoke": "playwright test --config=runners/smoke.runner.ts --project=chromium",
    "regression": "playwright test --config=runners/regression.runner.ts --project=chromium",
    "sanity": "playwright test --config=runners/sanity.runner.ts --project=chromium",
    "admin": "playwright test --config=runners/admin.runner.ts --project=chromium",
    "job": "playwright test --config=runners/job.runner.ts --project=chromium",
    "priority": "playwright test --config=runners/priority.runner.ts",
    "priority:headed": "playwright test --config=runners/priority.runner.ts --headed",
    "priority:headless": "playwright test --config=runners/priority.runner.ts",
    "padcreation": "playwright test tests/padcreation.spec.ts --project=chromium --headed",
    "heat-transfer": "playwright test tests/HeatTransferParameters.spec.ts --project=chromium --headed",
    "channel-input": "playwright test tests/ChannelInput.spec.ts --project=chromium --headed",
    "job-comment": "playwright test tests/JobComment.spec.ts --project=chromium --headed",
    "reservoir-parameters": "playwright test tests/ReservoirParameters.spec.ts --project=chromium --headed",
    "design-treatment-scheduled": "playwright test tests/DesignTreatmentScheduled.spec.ts --project=chromium --headed",
    "actual-treatment-scheduled": "playwright test tests/ActualTreatmentScheduled.spec.ts --project=chromium --headed",
    "treatment-totals": "playwright test tests/TreatmentTotals.spec.ts --project=chromium --headed",
    "smoke:headed": "playwright test --config=runners/smoke.runner.ts --headed --project=chromium",
    "regression:headed": "playwright test --config=runners/regression.runner.ts --headed --project=chromium",
    "smoke:sequential": "playwright test --config=runners/smoke.runner.ts --project=chromium --workers=1",
    "regression:sequential": "playwright test --config=runners/regression.runner.ts --project=chromium --workers=1",
    "regression:retry": "playwright test --config=runners/regression.runner.ts --project=chromium --retries=2",
    "init:excel": "node scripts/init-excel-test-data.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "liveplus"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.2.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  }
}
